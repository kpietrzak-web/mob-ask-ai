# Required
OPENAI_API_KEY=
APP_KEY=your_app_key_here

# Optional (defaults shown)
# NODE_ENV=production               # set to "development" to enable verbose (PII) dev logs
# PORT=3000
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_CHAT_REASONING_EFFORT=low      # set empty for non-reasoning models (e.g. gpt-4.1)
# OPENAI_CHAT_MAX_OUTPUT_TOKENS=4096
# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_VOICE=marin
# OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Token-usage logging to PostgreSQL (off by default)
# USAGE_LOGGING=false               # set to "true" to write per-model-call usage/cost to Postgres
# DATABASE_URL=postgres://user:pass@localhost:5432/mob_ask_ai   # required when USAGE_LOGGING=true
# USAGE_HASH_SALT=change_me         # salt for non-reversible user/tenant hashes (no PII stored)

# Sentry (optional, for error tracking)
# SENTRY_DSN=
